# ── Frontend (exposed to browser) ────────────────────────────────────────────
# In local dev, keep as /api so Vite's proxy handles the request
# In production (Vercel), set this to your full Railway URL:
#   VITE_API_BASE_URL=https://your-railway-url.up.railway.app
VITE_API_BASE_URL=/api

# App name shown in tab/title
VITE_APP_NAME=Gaby SMS

# ── Dev proxy (server-side only, never sent to browser) ───────────────────────
# Full backend URL used by the Vite dev server proxy.
# No VITE_ prefix — this never ends up in the browser bundle.
API_TARGET=https://your-railway-url.up.railway.app
